#!/usr/bin/env python3
import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
try:
    gi.require_version("WebKit2", "4.1")
except ValueError:
    gi.require_version("WebKit2", "4.0")

from gi.repository import Gdk, Gio, GLib, Gtk, WebKit2

APP_ID = "net.tate_note.TateNote"
INSTALLED_ASSETS = "/usr/share/tate-note/assets"
DEV_ASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets")
ASSETS_DIR = DEV_ASSETS if os.path.isdir(DEV_ASSETS) else INSTALLED_ASSETS

DEFAULT_SETTINGS = {
    "line_numbers": False,
    "count_newlines": True,
    "show_whitespace": False,
}


def settings_path():
    return os.path.join(GLib.get_user_config_dir(), "tate-note", "settings.json")


def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    try:
        with open(settings_path(), "r", encoding="utf-8") as f:
            stored = json.load(f)
    except (OSError, ValueError):
        return settings
    if isinstance(stored, dict):
        for key in DEFAULT_SETTINGS:
            if isinstance(stored.get(key), bool):
                settings[key] = stored[key]
    return settings


def save_settings(settings):
    path = settings_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, ensure_ascii=False, indent=2)
    except OSError:
        pass  # a read-only config dir must not break editing


class TateNoteWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="縦書きノート")
        self.set_default_size(760, 640)

        self.current_path = None
        self.text = ""
        self.modified = False
        self.settings = load_settings()

        self._build_header_bar()

        self.webview = WebKit2.WebView()
        self.webview.set_settings(self._make_settings())

        manager = self.webview.get_user_content_manager()
        manager.register_script_message_handler("app")
        manager.connect("script-message-received::app", self._on_js_message)

        # Settings can only reach the page once it has loaded.
        self.webview.connect("load-changed", self._on_load_changed)
        self.webview.load_uri("file://" + os.path.join(ASSETS_DIR, "editor.html"))

        self.add(self.webview)
        self.connect("delete-event", self._on_delete_event)
        self.show_all()
        self.webview.grab_focus()

    def _make_settings(self):
        settings = WebKit2.Settings()
        settings.set_enable_developer_extras(False)
        settings.set_default_charset("utf-8")
        return settings

    def _build_header_bar(self):
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("縦書きノート")
        self.set_titlebar(header)

        new_btn = Gtk.Button.new_from_icon_name("document-new-symbolic", Gtk.IconSize.BUTTON)
        new_btn.set_tooltip_text("新規 (Ctrl+N)")
        new_btn.connect("clicked", lambda _b: self.action_new())
        header.pack_start(new_btn)

        open_btn = Gtk.Button.new_from_icon_name("document-open-symbolic", Gtk.IconSize.BUTTON)
        open_btn.set_tooltip_text("開く (Ctrl+O)")
        open_btn.connect("clicked", lambda _b: self.action_open())
        header.pack_start(open_btn)

        save_btn = Gtk.Button.new_from_icon_name("document-save-symbolic", Gtk.IconSize.BUTTON)
        save_btn.set_tooltip_text("保存 (Ctrl+S)")
        save_btn.connect("clicked", lambda _b: self.action_save())
        header.pack_start(save_btn)

        save_as_btn = Gtk.Button.new_from_icon_name("document-save-as-symbolic", Gtk.IconSize.BUTTON)
        save_as_btn.set_tooltip_text("名前を付けて保存 (Ctrl+Shift+S)")
        save_as_btn.connect("clicked", lambda _b: self.action_save_as())
        header.pack_start(save_as_btn)

        zoom_out = Gtk.Button.new_from_icon_name("zoom-out-symbolic", Gtk.IconSize.BUTTON)
        zoom_out.set_tooltip_text("文字を小さく")
        zoom_out.connect("clicked", lambda _b: self.action_zoom(-2))
        header.pack_end(zoom_out)

        zoom_in = Gtk.Button.new_from_icon_name("zoom-in-symbolic", Gtk.IconSize.BUTTON)
        zoom_in.set_tooltip_text("文字を大きく")
        zoom_in.connect("clicked", lambda _b: self.action_zoom(2))
        header.pack_end(zoom_in)

        self._build_settings_menu(header)

        self.count_label = Gtk.Label(label="0字")
        self.count_label.set_margin_start(6)
        self.count_label.set_margin_end(6)
        header.pack_end(self.count_label)

        self.header = header
        header.show_all()
        self._update_title()

        accel = Gtk.AccelGroup()
        self.add_accel_group(accel)
        self._add_accel(accel, "n", lambda: self.action_new())
        self._add_accel(accel, "o", lambda: self.action_open())
        self._add_accel(accel, "s", lambda: self.action_save())
        self._add_accel(accel, "s", lambda: self.action_save_as(), shift=True)
        # 診断用 (issue #1): レイアウト情報を ~/tate-note-layout.txt に書き出す
        self._add_accel(accel, "d", lambda: self._run_js("window.dumpLayout()"), shift=True)

    def _build_settings_menu(self, header):
        button = Gtk.MenuButton()
        button.set_image(
            Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON)
        )
        button.set_tooltip_text("設定")

        # A Gtk.Menu, not a Gtk.Popover with check buttons. The popover is drawn
        # over the WebKitWebView, which owns a native subwindow and takes the
        # first button press for itself: the click only moved the keyboard focus
        # onto the check button and the toggle was swallowed, so the first click
        # on any row appeared to do nothing. A menu runs in its own toplevel with
        # its own pointer grab, so every click reaches the item.
        menu = Gtk.Menu()
        self.setting_checks = {}
        for key, label in (
            ("line_numbers", "行番号を表示"),
            ("count_newlines", "改行を文字数に含める"),
            ("show_whitespace", "空白・タブ・改行を表示"),
        ):
            item = Gtk.CheckMenuItem.new_with_label(label)
            item.set_active(self.settings[key])
            item.connect("toggled", self._on_setting_toggled, key)
            # Toggling must not dismiss the menu - these are three independent
            # options and one usually wants to set more than one. Handling the
            # release ourselves keeps the menu shell from activating the item
            # and deactivating the menu with it.
            item.connect("button-release-event", self._on_setting_clicked)
            menu.append(item)
            self.setting_checks[key] = item

        menu.show_all()
        button.set_popup(menu)
        self.settings_button = button
        self.settings_menu = menu
        header.pack_end(button)

    def _on_setting_clicked(self, item, _event):
        item.set_active(not item.get_active())
        return True   # swallow the release so the menu stays open

    def _on_setting_toggled(self, check, key):
        if self.settings[key] == check.get_active():
            return
        self.settings[key] = check.get_active()
        save_settings(self.settings)
        self._apply_settings()

    def _apply_settings(self):
        self._run_js("window.setOptions({})".format(json.dumps({
            "lineNumbers": self.settings["line_numbers"],
            "showWhitespace": self.settings["show_whitespace"],
        })))
        self._update_count()

    def _update_count(self):
        text = self.text if self.settings["count_newlines"] else self.text.replace("\n", "")
        self.count_label.set_text("{}字".format(len(text)))

    def _on_load_changed(self, _webview, event):
        if event == WebKit2.LoadEvent.FINISHED:
            self._apply_settings()

    def _add_accel(self, accel, key, callback, shift=False):
        mods = Gdk.ModifierType.CONTROL_MASK
        if shift:
            mods |= Gdk.ModifierType.SHIFT_MASK
        keyval = Gdk.keyval_from_name(key)
        accel.connect(keyval, mods, Gtk.AccelFlags.VISIBLE, lambda *_a: callback())

    def _run_js(self, script):
        # evaluate_javascript() exists from WebKitGTK 2.40; older 4.0 builds only
        # provide the deprecated run_javascript().
        if hasattr(self.webview, "evaluate_javascript"):
            self.webview.evaluate_javascript(script, -1, None, None, None, None, None)
        else:
            self.webview.run_javascript(script, None, None, None)

    def _update_title(self):
        name = os.path.basename(self.current_path) if self.current_path else "無題"
        mark = " *" if self.modified else ""
        self.header.set_title("縦書きノート")
        self.header.set_subtitle(name + mark)

    def _on_js_message(self, _manager, result):
        payload = json.loads(result.get_js_value().to_string())
        if payload.get("type") == "debug":
            self._write_debug_report(payload.get("report", ""))
            return
        if payload.get("type") != "changed":
            return
        # The editor mirrors its whole buffer on every edit, so saving never has
        # to wait for a round trip to JavaScript.
        self.text = payload.get("text", "")
        self._update_count()
        if not self.modified:
            self.modified = True
            self._update_title()

    def _write_debug_report(self, report):
        path = os.path.join(GLib.get_home_dir(), "tate-note-layout.txt")
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(report)
        except OSError as e:
            self._error_dialog("診断情報を書き出せませんでした: {}".format(e))
            return
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
            text="レイアウト診断を書き出しました",
        )
        dialog.format_secondary_text(path)
        dialog.run()
        dialog.destroy()

    def _write_content(self, path):
        text = self.text
        if text:
            text += "\n"
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
        except OSError as e:
            self._error_dialog("保存に失敗しました: {}".format(e))
            return False
        self.current_path = path
        self.modified = False
        self._update_title()
        return True

    def _error_dialog(self, message):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=message,
        )
        dialog.run()
        dialog.destroy()

    def _confirm_discard(self):
        if not self.modified:
            return True
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text="変更を保存しますか？",
        )
        dialog.add_buttons(
            "破棄", Gtk.ResponseType.NO,
            "キャンセル", Gtk.ResponseType.CANCEL,
            "保存", Gtk.ResponseType.YES,
        )
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.YES:
            return self.action_save()
        return response == Gtk.ResponseType.NO

    def action_new(self):
        if not self._confirm_discard():
            return
        self._set_content("")
        self.current_path = None
        self._update_title()

    def _set_content(self, text):
        self.text = text
        self.modified = False
        self._update_count()
        self._run_js("window.setContent({})".format(json.dumps(text)))

    def action_open(self):
        if not self._confirm_discard():
            return
        dialog = Gtk.FileChooserDialog(
            title="ファイルを開く",
            transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_buttons(
            "キャンセル", Gtk.ResponseType.CANCEL,
            "開く", Gtk.ResponseType.OK,
        )
        text_filter = Gtk.FileFilter()
        text_filter.set_name("テキストファイル (*.txt)")
        text_filter.add_pattern("*.txt")
        dialog.add_filter(text_filter)
        all_filter = Gtk.FileFilter()
        all_filter.set_name("すべてのファイル")
        all_filter.add_pattern("*")
        dialog.add_filter(all_filter)

        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            self._load_file(path)
        dialog.destroy()

    def _load_file(self, path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            self._error_dialog("開けませんでした: {}".format(e))
            return
        self._set_content(text.rstrip("\n"))
        self.current_path = path
        self._update_title()

    def action_save(self):
        if not self.current_path:
            return self.action_save_as()
        return self._write_content(self.current_path)

    def action_save_as(self):
        dialog = Gtk.FileChooserDialog(
            title="名前を付けて保存",
            transient_for=self,
            action=Gtk.FileChooserAction.SAVE,
        )
        dialog.add_buttons(
            "キャンセル", Gtk.ResponseType.CANCEL,
            "保存", Gtk.ResponseType.OK,
        )
        dialog.set_do_overwrite_confirmation(True)
        dialog.set_current_name(
            os.path.basename(self.current_path) if self.current_path else "無題.txt"
        )
        if self.current_path:
            dialog.set_current_folder(os.path.dirname(self.current_path))

        saved = False
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            if not path.lower().endswith(".txt"):
                path += ".txt"
            saved = self._write_content(path)
        dialog.destroy()
        return saved

    def action_zoom(self, delta):
        self._run_js(
            "window.setFontSize(Math.max(12, Math.min(64, window.getFontSize() + {})))".format(delta)
        )

    def _on_delete_event(self, _widget, _event):
        return not self._confirm_discard()


class TateNoteApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.window = None
        self._pending_open_path = None

    def do_activate(self):
        if not self.window:
            self.window = TateNoteWindow(self)
            if self._pending_open_path:
                self.window._load_file(self._pending_open_path)
                self._pending_open_path = None
        self.window.present()

    def do_open(self, files, _n_files, _hint):
        self._pending_open_path = files[0].get_path()
        self.activate()


def main():
    app = TateNoteApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
