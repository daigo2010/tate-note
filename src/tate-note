#!/usr/bin/env python3
"""縦書きノート - a vertical-writing (tategaki) text editor.

Pango lays the text out; this application draws it. Owning the drawing is what
keeps the caret, the line numbers and the whitespace marks from interfering with
one another - each is placed from measurements rather than left to an embedded
engine's discretion. Documents open in tabs, each with its own memo.
"""

import json
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Pango", "1.0")

from gi.repository import Gdk, Gio, GLib, Gtk, Pango

# Run from a checkout or from an installed copy: the modules sit beside this
# script in the source tree, and under /usr/share once packaged.
_HERE = os.path.dirname(os.path.abspath(__file__))
_INSTALLED = "/usr/share/tate-note"
sys.path.insert(0, _HERE if os.path.exists(os.path.join(_HERE, "tateview.py"))
                else _INSTALLED)

from tatedoc import Document
from tatetree import FolderTree

APP_ID = "net.tate_note.TateNote"

DEFAULT_SETTINGS = {
    "line_numbers": False,
    "count_newlines": True,
    "show_whitespace": False,
    "show_memo": True,
    "show_folder": False,
}


def settings_path():
    return os.path.join(GLib.get_user_config_dir(), "tate-note", "settings.json")


def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    try:
        with open(settings_path(), "r", encoding="utf-8") as f:
            stored = json.load(f)
    except (OSError, ValueError):
        return settings
    if isinstance(stored, dict):
        for key in DEFAULT_SETTINGS:
            if isinstance(stored.get(key), bool):
                settings[key] = stored[key]
        # Not a toggle, so it is carried across separately.
        if isinstance(stored.get("last_folder"), str):
            settings["last_folder"] = stored["last_folder"]
    return settings


def save_settings(settings):
    path = settings_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, ensure_ascii=False, indent=2)
    except OSError:
        pass


class TateNoteWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="縦書きノート")
        # The icon is installed under the application ID, and a Wayland shell
        # finds it by matching the window's app_id against the .desktop file of
        # that name. Naming it here as well covers X11, where the icon travels
        # with the window rather than with the launcher.
        self.set_icon_name(APP_ID)
        # Vertical text runs off to the left, so the more width there is the
        # more of the document is on screen; start filling the display. The
        # default size is what un-maximising falls back to.
        self.set_default_size(760, 640)
        self.maximize()

        self.settings = load_settings()
        self.font_size = 22.0

        self.notebook = Gtk.Notebook()
        self.notebook.set_scrollable(True)
        self.notebook.connect("switch-page", self._on_switch_page)

        # The tree sits outside the notebook: it belongs to the window, not to
        # any one document, and lives to the right of the per-tab memo pane.
        self.tree = FolderTree()
        self.tree.connect("file-activated", lambda _t, path: self.open_path(path))
        self.tree.connect("folder-requested", lambda _t: self.action_open_folder())

        self.split = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.split.set_start_child(self.notebook)
        self.split.set_resize_start_child(True)
        self.split.set_shrink_start_child(False)
        self.split.set_end_child(self.tree)
        self.split.set_resize_end_child(False)
        self.split.set_shrink_end_child(False)

        self._build_header()
        self.set_child(self.split)
        self._install_shortcuts()

        self.tree.set_visible(self.settings["show_folder"])
        last = self.settings.get("last_folder")
        if last and os.path.isdir(last):
            self.tree.set_root(last)

        self.new_tab()
        self.connect("map", lambda *_a: self._focus_current())

    # ---- tabs ------------------------------------------------------------

    def current(self):
        page = self.notebook.get_current_page()
        return self.notebook.get_nth_page(page) if page >= 0 else None

    def documents(self):
        return [self.notebook.get_nth_page(i)
                for i in range(self.notebook.get_n_pages())]

    def new_tab(self, path=None):
        """Open a document in a tab, reusing a blank one rather than piling up."""
        doc = self.current()
        if doc is None or not doc.is_untouched:
            doc = Document()
            doc.connect("state-changed", self._on_doc_state)
            self._apply_settings_to(doc)
            index = self.notebook.append_page(doc, self._tab_label(doc))
            self.notebook.set_tab_reorderable(doc, True)
            self.notebook.set_current_page(index)
        if path:
            try:
                doc.load(path)
            except (OSError, UnicodeDecodeError) as e:
                self._error("開けませんでした: {}".format(e))
        self._refresh_tab(doc)
        self._update_header()
        self._focus_current()
        return doc

    def _tab_label(self, doc):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        label = Gtk.Label(label=doc.label)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        # An ellipsizing label asks for almost no width, so without a floor it
        # collapses to a bare "…"; the cap keeps long names from taking over.
        label.set_width_chars(10)
        label.set_max_width_chars(20)
        close = Gtk.Button(icon_name="window-close-symbolic")
        close.add_css_class("flat")
        close.set_has_frame(False)
        close.connect("clicked", lambda _b, d=doc: self.close_tab(d))
        box.append(label)
        box.append(close)
        doc._tab_title = label                 # so the label can be refreshed
        return box

    def _refresh_tab(self, doc):
        title = getattr(doc, "_tab_title", None)
        if title is not None:
            title.set_text(doc.label)
        self.notebook.set_show_tabs(self.notebook.get_n_pages() > 1)

    def close_tab(self, doc):
        # The answer arrives from a dialog, so the tab goes away in a callback
        # rather than on the way out of this method.
        if not doc.modified:
            self._drop_tab(doc)
            return
        self.notebook.set_current_page(self.notebook.page_num(doc))
        self._confirm_discard(doc, lambda: self._drop_tab(doc))

    def _drop_tab(self, doc):
        index = self.notebook.page_num(doc)
        if index < 0:
            return
        self.notebook.remove_page(index)
        if self.notebook.get_n_pages() == 0:
            self.new_tab()
        else:
            self._refresh_tab(self.current())
            self._update_header()
            self._focus_current()

    def _on_switch_page(self, _notebook, _page, _num):
        GLib.idle_add(self._after_switch)

    def _after_switch(self):
        self._update_header()
        self._focus_current()
        return False

    def _focus_current(self):
        doc = self.current()
        if doc is not None:
            self.set_focus(doc.view)
            doc.view.grab_focus()

    def _on_doc_state(self, doc):
        self._refresh_tab(doc)
        if doc is self.current():
            self._update_header()

    # ---- chrome ----------------------------------------------------------

    def _build_header(self):
        header = Gtk.HeaderBar()
        self.set_titlebar(header)

        for icon, tip, handler in (
            ("tab-new-symbolic", "新しいタブ (Ctrl+T)", self.action_new),
            ("document-open-symbolic", "開く (Ctrl+O)", self.action_open),
            ("folder-open-symbolic", "フォルダを開く", self.action_open_folder),
            ("document-save-symbolic", "保存 (Ctrl+S)", self.action_save),
            ("document-save-as-symbolic", "名前を付けて保存", self.action_save_as),
        ):
            button = Gtk.Button(icon_name=icon)
            button.set_tooltip_text(tip)
            button.connect("clicked", lambda _b, fn=handler: fn())
            header.pack_start(button)

        zoom_out = Gtk.Button(icon_name="zoom-out-symbolic")
        zoom_out.set_tooltip_text("文字を小さく")
        zoom_out.connect("clicked", lambda _b: self.zoom(-2))
        header.pack_end(zoom_out)

        zoom_in = Gtk.Button(icon_name="zoom-in-symbolic")
        zoom_in.set_tooltip_text("文字を大きく")
        zoom_in.connect("clicked", lambda _b: self.zoom(2))
        header.pack_end(zoom_in)

        header.pack_end(self._settings_button())

        self.count_label = Gtk.Label(label="0字")
        header.pack_end(self.count_label)

        self.subtitle = Gtk.Label(label="無題")
        self.subtitle.add_css_class("dim-label")
        header.set_title_widget(self.subtitle)

    def _settings_button(self):
        button = Gtk.MenuButton(icon_name="open-menu-symbolic")
        button.set_tooltip_text("設定")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for edge in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + edge)(12)
        self.setting_checks = {}
        for key, label in (
            ("line_numbers", "行番号を表示"),
            ("count_newlines", "改行を文字数に含める"),
            ("show_whitespace", "空白・タブ・改行を表示"),
            ("show_memo", "メモを表示"),
            ("show_folder", "フォルダを表示"),
        ):
            check = Gtk.CheckButton(label=label)
            check.set_active(self.settings[key])
            check.connect("toggled", self._on_setting_toggled, key)
            box.append(check)
            self.setting_checks[key] = check
        popover = Gtk.Popover()
        popover.set_child(box)
        button.set_popover(popover)
        return button

    def _on_setting_toggled(self, check, key):
        if self.settings[key] == check.get_active():
            return
        self.settings[key] = check.get_active()
        save_settings(self.settings)
        for doc in self.documents():
            self._apply_settings_to(doc)
        self.tree.set_visible(self.settings["show_folder"])
        self._update_header()

    def _apply_settings_to(self, doc):
        doc.view.set_show_line_numbers(self.settings["line_numbers"])
        doc.view.set_show_whitespace(self.settings["show_whitespace"])
        doc.view.set_font_size(self.font_size)
        doc.set_show_memo(self.settings["show_memo"])

    def _update_header(self):
        doc = self.current()
        if doc is None:
            return
        self.subtitle.set_text(doc.label)
        self.count_label.set_text(
            "{}字".format(doc.char_count(self.settings["count_newlines"])))

    def zoom(self, delta):
        self.font_size = max(8.0, min(96.0, self.font_size + delta))
        for doc in self.documents():
            doc.view.set_font_size(self.font_size)

    # ---- shortcuts -------------------------------------------------------

    def _install_shortcuts(self):
        # Typing and caret keys belong to the view; these are window commands.
        for accel, handler in (("<Control>t", self.action_new),
                               ("<Control>n", self.action_new),
                               ("<Control>o", self.action_open),
                               ("<Control>s", self.action_save),
                               ("<Control><Shift>s", self.action_save_as),
                               ("<Control>w", self.action_close_tab),
                               ("<Control>f", self.action_find),
                               ("<Control>h", self.action_replace),
                               ("<Control>g", self.action_find_next),
                               ("<Control><Shift>g", self.action_find_previous),
                               ("<Control>Page_Down", self.action_next_tab),
                               ("<Control>Page_Up", self.action_prev_tab)):
            trigger = Gtk.ShortcutTrigger.parse_string(accel)
            action = Gtk.CallbackAction.new(
                lambda _w, _a, fn=handler: (fn(), True)[1])
            self.add_shortcut(Gtk.Shortcut.new(trigger, action))

    def action_find(self):
        doc = self.current()
        if doc is not None:
            doc.search.open()

    def action_replace(self):
        doc = self.current()
        if doc is not None:
            doc.search.open(replace=True)

    def action_find_next(self):
        doc = self.current()
        if doc is not None and doc.search.get_reveal_child():
            doc.search.step(1)

    def action_find_previous(self):
        doc = self.current()
        if doc is not None and doc.search.get_reveal_child():
            doc.search.step(-1)

    def action_next_tab(self):
        count = self.notebook.get_n_pages()
        if count > 1:
            self.notebook.set_current_page(
                (self.notebook.get_current_page() + 1) % count)

    def action_prev_tab(self):
        count = self.notebook.get_n_pages()
        if count > 1:
            self.notebook.set_current_page(
                (self.notebook.get_current_page() - 1) % count)

    def action_close_tab(self):
        doc = self.current()
        if doc is not None:
            self.close_tab(doc)

    # ---- files -----------------------------------------------------------

    def action_new(self):
        self.new_tab()

    def action_open(self):
        dialog = Gtk.FileChooserNative.new(
            "ファイルを開く", self, Gtk.FileChooserAction.OPEN, "開く", "キャンセル")
        text_filter = Gtk.FileFilter()
        text_filter.set_name("テキストファイル (*.txt)")
        text_filter.add_pattern("*.txt")
        dialog.add_filter(text_filter)
        every = Gtk.FileFilter()
        every.set_name("すべてのファイル")
        every.add_pattern("*")
        dialog.add_filter(every)
        dialog.connect("response", self._on_open_response)
        dialog.show()
        self._open_dialog = dialog          # keep it alive

    def _on_open_response(self, dialog, response):
        if response == Gtk.ResponseType.ACCEPT:
            gfile = dialog.get_file()
            if gfile is not None:
                self.open_path(gfile.get_path())
        dialog.destroy()
        self._open_dialog = None

    def open_path(self, path):
        """Bring the file forward if it is already open, otherwise add a tab."""
        for doc in self.documents():
            if doc.path == path:
                self.notebook.set_current_page(self.notebook.page_num(doc))
                self._focus_current()
                return doc
        return self.new_tab(path)

    def action_open_folder(self):
        dialog = Gtk.FileChooserNative.new(
            "フォルダを開く", self, Gtk.FileChooserAction.SELECT_FOLDER,
            "開く", "キャンセル")
        dialog.connect("response", self._on_folder_response)
        dialog.show()
        self._folder_dialog = dialog

    def _on_folder_response(self, dialog, response):
        if response == Gtk.ResponseType.ACCEPT:
            gfile = dialog.get_file()
            if gfile is not None:
                self.show_folder(gfile.get_path())
        dialog.destroy()
        self._folder_dialog = None

    def show_folder(self, path):
        """Open a folder in the tree, revealing the pane if it was hidden."""
        self.tree.set_root(path)
        self.settings["show_folder"] = True
        self.settings["last_folder"] = path
        save_settings(self.settings)
        self.tree.set_visible(True)
        if "show_folder" in self.setting_checks:
            self.setting_checks["show_folder"].set_active(True)

    def action_save(self):
        doc = self.current()
        if doc is None:
            return
        if not doc.path:
            self.action_save_as()
            return
        self._write(doc, doc.path)

    def action_save_as(self, doc=None, done=None):
        doc = doc or self.current()
        if doc is None:
            return
        dialog = Gtk.FileChooserNative.new(
            "名前を付けて保存", self, Gtk.FileChooserAction.SAVE, "保存", "キャンセル")
        dialog.set_current_name(doc.title if doc.path else "無題.txt")
        dialog.connect("response", self._on_save_response, doc, done)
        dialog.show()
        self._save_dialog = dialog

    def _on_save_response(self, dialog, response, doc, done=None):
        saved = False
        if response == Gtk.ResponseType.ACCEPT:
            gfile = dialog.get_file()
            if gfile is not None:
                path = gfile.get_path()
                if not path.lower().endswith(".txt"):
                    path += ".txt"
                saved = self._write(doc, path)
        dialog.destroy()
        self._save_dialog = None
        # Only carry on with whatever was waiting on the save if it worked;
        # a cancelled dialog has to leave the document where it was.
        if saved and done is not None:
            done()

    def _write(self, doc, path):
        try:
            doc.save(path)
        except OSError as e:
            self._error("保存に失敗しました: {}".format(e))
            return False
        return True

    def _save_then(self, doc, done):
        """Save the document however it needs saving, then carry on."""
        if doc.path:
            if self._write(doc, doc.path):
                done()
            return
        self.action_save_as(doc, done)

    # ---- dialogs ---------------------------------------------------------

    def _confirm_discard(self, doc, proceed):
        """Ask before a modified document is thrown away.

        `proceed` runs once the document is safe to lose - either because it has
        just been saved, or because the answer was to discard it. Cancelling, or
        dismissing the dialog, simply does not call it.
        """
        dialog = Gtk.AlertDialog()
        dialog.set_modal(True)
        dialog.set_message("「{}」の変更を保存しますか？".format(doc.title))
        dialog.set_detail("保存しないと、変更内容は失われます。")
        dialog.set_buttons(["キャンセル", "保存しない", "保存"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(2)

        def answered(source, result):
            try:
                choice = source.choose_finish(result)
            except GLib.Error:
                return                  # dismissed: keep the document
            if choice == 1:
                proceed()
            elif choice == 2:
                self._save_then(doc, proceed)

        dialog.choose(self, None, answered)

    # ---- quitting --------------------------------------------------------

    def do_close_request(self):
        if getattr(self, "_leaving", False):
            return False
        pending = [doc for doc in self.documents() if doc.modified]
        if not pending:
            return False
        # Hold the window open and work through the unsaved tabs one at a time.
        self._ask_before_quitting(pending)
        return True

    def _ask_before_quitting(self, pending):
        if not pending:
            self._leaving = True
            self.destroy()
            return
        doc, rest = pending[0], pending[1:]
        if self.notebook.page_num(doc) < 0:
            self._ask_before_quitting(rest)
            return
        self.notebook.set_current_page(self.notebook.page_num(doc))
        self._confirm_discard(doc, lambda: self._ask_before_quitting(rest))

    def _error(self, message):
        dialog = Gtk.AlertDialog()
        dialog.set_message(message)
        dialog.show(self)


class TateNoteApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.window = None
        self._pending = []

    def do_activate(self):
        if self.window is None:
            self.window = TateNoteWindow(self)
            for path in self._pending:
                self.window.open_path(path)
            self._pending = []
        self.window.present()

    def do_open(self, files, _n, _hint):
        paths = [f.get_path() for f in files if f.get_path()]
        if self.window is None:
            self._pending = paths
            self.activate()
        else:
            for path in paths:
                self.window.open_path(path)
            self.window.present()


def main():
    return TateNoteApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
